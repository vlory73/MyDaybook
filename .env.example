# MyDaybook settings. Copy to .env (mode 600, never committed). Non-secret values only in this file.

# Public address of the app, exactly as people open it. A PWA's identity is its origin: changing it forces
# everyone to reinstall. The container passes it on to adapter-node as ORIGIN (leave ORIGIN unset).
PUBLIC_URL=https://lory-home.duckdns.org:8444

# Address the reverse proxy connects from, as seen inside the container (Compose gateway, see compose.yaml).
# X-Forwarded-For is believed only from this address. Comma-separated for more than one.
TRUSTED_PROXY=172.30.90.1

TZ=Europe/Copenhagen

# How long IP addresses are kept in security events, in days.
IP_RETENTION_DAYS=7

# Nightly backup into /backup (compose.yaml mounts ./backup there). Pi local time; the NAS copies it by 01:00.
BACKUP_TIME=23:30
BACKUP_KEEP=3

# HSTS max-age in seconds (never includeSubDomains or preload). 86400 for the first weeks, then 31536000.
HSTS_MAX_AGE=86400

# Session cookie gets the Secure flag. Only set false for a local plain-http smoke test.
COOKIE_SECURE=true

# The app's own access log (method, route, status; never IPs). Off, as the proxy's log is off too.
ACCESS_LOG=off

# Secrets: generate with gen-secrets, never type them. Appends the three lines below to .env:
#   docker run --rm ghcr.io/vlory73/mydaybook:0.1.0 gen-secrets >> .env
# SESSION_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
